node_modules/
dist/
# Catch-all: a bare `.env` rule does not cover `.env.bak-<ts>` (written by
# scripts/rotate-uo-token.mjs), `.env.old`, or anything else created while
# debugging — and every one of those holds the same secrets as `.env`.
.env*
!.env.example
*.log
.DS_Store
tsbuildinfo
migrations/meta/_journal.json.lock
.vercel

# Local tooling artifacts (not app code)
.claude/
.agents/
.playwright-mcp/

# Table exports taken before destructive migrations (may hold guest PII)
docs/migration-backups/

# Per-property arrival info (wifi password, entry codes) fed to scripts/set-access-info.mjs
scripts/access-info.local.json
